NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Redis is optional in the current single-instance deployment. Do not point
# production at localhost; configure a TLS/authenticated URL only if enabled.
REDIS_URL=

# Server-only secret used as the password-hashing pepper.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Seed-only credentials for the development ADMIN bootstrap.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-secure-password-at-least-12-characters
# Demo catalog is enabled by default only outside production. Set true in production only intentionally.
SEED_DEMO_CATALOG=false
# Optional Google customer sign-in credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional production email delivery. Development logs reset codes when absent.
RESEND_API_KEY=
EMAIL_FROM=Your Store <no-reply@example.com>

# Customer OTP delivery boundaries. No development code provider is valid in production.
CUSTOMER_OTP_SMS_PROVIDER=
CUSTOMER_OTP_SMS_API_URL=
CUSTOMER_OTP_SMS_API_KEY=
CUSTOMER_OTP_EMAIL_PROVIDER=
CUSTOMER_OTP_EMAIL_API_URL=
CUSTOMER_OTP_EMAIL_API_KEY=

# Payzaty remains behind ONLINE_PAYMENT. Use only the merchant's documented URLs.
PAYZATY_ACCOUNT_NO=
PAYZATY_SECRET_KEY=
PAYZATY_BASE_URL=
PAYZATY_STATUS_ENDPOINT=
PAYZATY_SANDBOX=false

# SPL production credentials are intentionally empty until an official contract is supplied.
SPL_PROVIDER=
SPL_API_BASE_URL=
SPL_API_KEY=

# Maximum accepted image upload size in bytes (default: 5242880 / 5 MB).
UPLOAD_MAX_BYTES=5242880

# Production market authority. Use `vercel` for direct Vercel deployments; use
# `trusted_proxy` when a reverse proxy owns both the country and trust headers.
MARKET_GEO_PROVIDER=trusted_proxy
# Production reverse proxy must strip client-supplied values and inject both headers.
MARKET_TRUSTED_COUNTRY_HEADER=x-vercel-ip-country
MARKET_TRUSTED_PROXY_HEADER=x-market-trust-token
MARKET_TRUSTED_PROXY_SECRET=
# Development/test-only fallback when no trusted country header is available.
# Use EGYPT for EGP or SAUDI_ARABIA for SAR. Ignored in production.
MARKET_DEVELOPMENT_FALLBACK=SAUDI_ARABIA

# Storage policy. Local is for development/test only; production must use s3.
STORAGE_PROVIDER=local
PUBLIC_STORAGE_ROOT=./public/uploads
PRIVATE_STORAGE_ROOT=./.private
# Required for STORAGE_PROVIDER=s3:
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_PUBLIC_BUCKET=
STORAGE_S3_PRIVATE_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
PUBLIC_MEDIA_BASE_URL=

# Vercel production example (keep real credentials in Vercel Environment Variables,
# never in this file):
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://maharat-kids.vercel.app
# MARKET_GEO_PROVIDER=vercel
# STORAGE_PROVIDER=s3
# STORAGE_S3_PUBLIC_BUCKET=your-public-bucket
# STORAGE_S3_PRIVATE_BUCKET=your-private-bucket
# STORAGE_S3_ACCESS_KEY_ID=your-access-key
# STORAGE_S3_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://your-s3-compatible-endpoint
# PUBLIC_MEDIA_BASE_URL=https://your-public-media-host
