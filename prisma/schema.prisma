// Reusable ecommerce framework schema for independent single-store applications.
// Models are grouped by domain module so responsibility and future growth remain clear.
// Add new models only inside the corresponding module section.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// IDENTITY & ACCESS MODULE
// Authentication identity, account type, admin RBAC
// ======================================================

// Enumerates lifecycle states for application users.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

// Identifies the account boundary used by the single-store application.
// CUSTOMER accounts do not participate in the administration RBAC model.
enum UserType {
  ADMIN
  CUSTOMER
}

// Localized customer-facing catalog and promotion content.
enum ContentLocale {
  ar
  en
}

// Commercial authority is independent from locale and never inferred from it.
enum Market {
  SAUDI_ARABIA
  EGYPT
}

enum ShippingRateSource {
  ADMIN_CONFIGURED
  CARRIER_API
}

enum CustomerIdentityChannel {
  PHONE
  EMAIL
}

enum OtpPurpose {
  CUSTOMER_AUTH
}

enum AddressSource {
  MANUAL
  SPL
}

enum AddressVerification {
  UNVERIFIED
  VERIFIED
}

enum AddressResolutionStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

// Represents any person who can access this ecommerce application.
// UserType separates administration accounts from storefront customers.
model User {
  id                        String                     @id @default(cuid())
  email                     String?                    @unique
  name                      String?
  phone                     String?
  // Customer OTP accounts intentionally have no password. Staff credentials stay required by service policy.
  passwordHash              String?
  type                      UserType                   @default(CUSTOMER)
  status                    UserStatus                 @default(PENDING)
  firstLoginAt              DateTime?
  lastLoginAt               DateTime?
  loginCount                Int                        @default(0)
  marketingConsent          Boolean                    @default(false)
  marketingConsentAt        DateTime?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  userRoles                 UserRole[]
  sessions                  Session[]
  oauthAccounts             OAuthAccount[]
  passwordResetCodes        PasswordResetCode[]
  addresses                 CustomerAddress[]
  addressResolutionSessions AddressResolutionSession[]
  cart                      Cart?
  orders                    Order[]
  orderStatusChanges        OrderStatusHistory[]       @relation("OrderStatusHistoryActor")
  paymentStatusChanges      PaymentStatusHistory[]     @relation("PaymentStatusHistoryActor")
  bankTransferReviews       BankTransferSubmission[]   @relation("BankTransferReviewer")
  settlementsSettled        PaymentSettlement[]        @relation("PaymentSettlementActor")
  shipmentStatusChanges     ShipmentStatusHistory[]    @relation("ShipmentStatusHistoryActor")
  settlementBatchesCreated  CarrierSettlementBatch[]   @relation("CarrierSettlementBatchActor")
  favorites                 Favorite[]
  notifications             Notification[]
  customerReturnRequests    ReturnRequest[]            @relation("ReturnCustomer")
  createdReturnRequests     ReturnRequest[]            @relation("ReturnCreator")
  returnStatusChanges       ReturnStatusHistory[]      @relation("ReturnStatusActor")
  refundsProcessed          Refund[]                   @relation("RefundProcessor")
  couponRedemptions         CouponRedemption[]         @relation("CouponRedemptionCustomer")
  reviews                   ProductReview[]
  moderatedReviews          ProductReview[]            @relation("ReviewModerator")
  auditLogs                 AuditLog[]                 @relation("AuditLogActor")
  identities                CustomerIdentity[]

  @@index([type, status, createdAt])
  @@index([type, marketingConsent])
}

// A verified reusable customer identity. PHONE and EMAIL values are canonicalized before persistence.
model CustomerIdentity {
  id              String                  @id @default(cuid())
  userId          String
  channel         CustomerIdentityChannel
  normalizedValue String
  verifiedAt      DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channel, normalizedValue])
  @@index([userId])
}

// OTP secrets are hashed. Rows remain for throttling and audit; consumption is atomically recorded.
model OtpChallenge {
  id                String                  @id @default(cuid())
  channel           CustomerIdentityChannel
  destination       String
  purpose           OtpPurpose              @default(CUSTOMER_AUTH)
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int                     @default(0)
  resendAvailableAt DateTime
  requestSourceHash String?
  consumedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([channel, destination, purpose, createdAt])
  @@index([requestSourceHash, createdAt])
  @@index([expiresAt])
}

// Defines administration roles only.
// CUSTOMER is an account type, not an administration role.
model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

// Defines granular actions allowed in the system.
// Permissions are assigned through roles.
model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  description     String?
  rolePermissions RolePermission[]
}

// Many-to-many relation between users and roles.
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// Many-to-many relation between roles and permissions.
model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ======================================================
// AUTHENTICATION MODULE
// Sessions, external accounts, password recovery
// ======================================================

// Represents a server-managed authenticated session.
// Only a hash of the browser token is persisted.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Links a customer account to an external identity provider.
// External identities never create administration roles.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Stores only a hash of a short-lived customer password-reset code.
model PasswordResetCode {
  id           String    @id @default(cuid())
  userId       String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  verifiedAt   DateTime?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// ======================================================
// CUSTOMER NOTIFICATIONS MODULE
// Private, in-app customer order and payment updates
// ======================================================

// Stores a customer-facing notification snapshot.
// Notification text and links are captured at creation time so later order
// changes do not rewrite the message a customer already received.
enum NotificationType {
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_COMPLETED
  ORDER_CANCELLED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  ORDER_DELIVERY_FAILED
  ORDER_RETURNED_TO_STORE
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_RECEIVED
  REFUND_COMPLETED
  REVIEW_APPROVED
  REVIEW_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  href      String?
  readAt    DateTime?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// ======================================================
// STORE CONFIGURATION MODULE
// Store settings and business information
// ======================================================

// Stores application-wide settings for one ecommerce store.
// The key identifies the setting and the JSON value keeps the model simple.
model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// CATALOG MODULE
// Products, hierarchical categories, and product images
// ======================================================

// Stores uploaded files independently from the catalog entities that reference them.
// The URL is public; path is owned by the storage provider and never exposed to clients.
model Media {
  id             String         @id @default(cuid())
  url            String
  path           String
  filename       String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  productImages  ProductImage[] @relation("ProductImageMedia")
  categoryImages Category[]     @relation("CategoryImage")
  promotions     Promotion[]    @relation("PromotionBannerMedia")

  @@index([path])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductLanguage {
  ARABIC
  ENGLISH
  BILINGUAL
  LANGUAGE_INDEPENDENT
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// A category can contain products, child categories, or both.
// Uploaded images use imageMediaId; imageUrl remains a legacy fallback.
model Category {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  parentId           String?
  description        String?
  imageUrl           String?
  imageMediaId       String?
  isActive           Boolean               @default(true)
  showInNavigation   Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  parent             Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]            @relation("CategoryTree")
  products           Product[]
  productAssignments ProductCategory[]
  primaryProducts    Product[]             @relation("ProductPrimaryCategory")
  imageMedia         Media?                @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  translations       CategoryTranslation[]

  @@index([parentId])
  @@index([imageMediaId])
  @@index([isActive, sortOrder])
}

// The minimum directly purchasable catalog item for a single-store application.
model Product {
  id                     String                     @id @default(cuid())
  name                   String
  slug                   String                     @unique
  shortDescription       String?
  description            String?
  sku                    String?                    @unique
  price                  Decimal                    @db.Decimal(12, 2)
  compareAtPrice         Decimal?                   @db.Decimal(12, 2)
  status                 ProductStatus              @default(DRAFT)
  isFeatured             Boolean                    @default(false)
  categoryId             String?
  primaryCategoryId      String?
  minAgeMonths           Int?
  maxAgeMonths           Int?
  difficultyLevel        DifficultyLevel?
  productLanguage        ProductLanguage            @default(LANGUAGE_INDEPENDENT)
  materials              String?
  numberOfPieces         Int?
  dimensions             String?
  recommendedPlayers     String?
  supervisionRequired    Boolean                    @default(false)
  safetyNotes            String?
  usageInstructions      String?
  trackInventory         Boolean                    @default(false)
  stockQuantity          Int                        @default(0)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  category               Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  primaryCategory        Category?                  @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: SetNull)
  categoryAssignments    ProductCategory[]
  skillAssignments       ProductSkill[]
  objectiveAssignments   ProductLearningObjective[]
  productTypeAssignments ProductProductType[]
  useContextAssignments  ProductUseContext[]
  ageGroups              ProductAgeGroup[]
  images                 ProductImage[]
  favorites              Favorite[]
  qualifyingPromotions   Promotion[]                @relation("PromotionQualifyingProduct")
  giftPromotions         Promotion[]                @relation("PromotionGiftProduct")
  reviews                ProductReview[]
  translations           ProductTranslation[]
  marketPrices           ProductMarketPrice[]
  options                ProductOption[]
  variants               ProductVariant[]

  @@index([status])
  @@index([categoryId])
  @@index([primaryCategoryId])
  @@index([minAgeMonths, maxAgeMonths])
  @@index([productLanguage])
  @@index([isFeatured])
}

model ProductCategory {
  productId  String
  categoryId String
  assignedAt DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model Skill {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      ProductSkill[]

  @@index([isActive, sortOrder])
}

model ProductSkill {
  productId String
  skillId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([productId, skillId])
  @@index([skillId, productId])
}

model LearningObjective {
  id            String                     @id @default(cuid())
  slug          String                     @unique
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  isActive      Boolean                    @default(true)
  sortOrder     Int                        @default(0)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  products      ProductLearningObjective[]

  @@index([isActive, sortOrder])
}

model ProductLearningObjective {
  productId           String
  learningObjectiveId String
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@id([productId, learningObjectiveId])
  @@index([learningObjectiveId, productId])
}

model ProductType {
  id        String               @id @default(cuid())
  slug      String               @unique
  nameAr    String
  nameEn    String
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  products  ProductProductType[]

  @@index([isActive, sortOrder])
}

model ProductProductType {
  productId     String
  productTypeId String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@id([productId, productTypeId])
  @@index([productTypeId, productId])
}

model UseContext {
  id        String              @id @default(cuid())
  slug      String              @unique
  nameAr    String
  nameEn    String
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  products  ProductUseContext[]

  @@index([isActive, sortOrder])
}

model ProductUseContext {
  productId    String
  useContextId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  useContext   UseContext @relation(fields: [useContextId], references: [id], onDelete: Cascade)

  @@id([productId, useContextId])
  @@index([useContextId, productId])
}

model AgeGroup {
  id           String            @id @default(cuid())
  slug         String            @unique
  nameAr       String
  nameEn       String
  minAgeMonths Int
  maxAgeMonths Int
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  products     ProductAgeGroup[]

  @@index([minAgeMonths, maxAgeMonths])
  @@index([isActive, sortOrder])
}

model ProductAgeGroup {
  productId  String
  ageGroupId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)

  @@id([productId, ageGroupId])
  @@index([ageGroupId, productId])
}

// The only customer-facing price authority. Legacy Product price fields are retained solely for migration compatibility.
model ProductMarketPrice {
  id             String   @id @default(cuid())
  productId      String
  market         Market
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, market])
  @@index([market, price])
}

// Product-scoped variant dimensions. Options and values are deliberately local to a
// product so catalog managers can evolve one product without changing global taxonomy.
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  nameAr    String
  nameEn    String
  sortOrder Int                  @default(0)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@index([productId, isActive, sortOrder])
}

model ProductOptionValue {
  id           String                      @id @default(cuid())
  optionId     String
  labelAr      String
  labelEn      String
  sortOrder    Int                         @default(0)
  isActive     Boolean                     @default(true)
  swatch       String?
  imageMediaId String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  option       ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants     ProductVariantOptionValue[]

  @@unique([optionId, labelEn])
  @@unique([optionId, labelAr])
  @@index([optionId, isActive, sortOrder])
}

model ProductVariant {
  id             String                      @id @default(cuid())
  productId      String
  sku            String                      @unique
  barcode        String?                     @unique
  active         Boolean                     @default(true)
  isDefault      Boolean                     @default(false)
  sortOrder      Int                         @default(0)
  trackInventory Boolean                     @default(true)
  stockQuantity  Int                         @default(0)
  combinationKey String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  product        Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   ProductVariantOptionValue[]
  marketPrices   ProductVariantMarketPrice[]
  images         ProductVariantImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@unique([productId, combinationKey])
  @@index([productId, active, sortOrder])
  @@index([productId, stockQuantity])
}

model ProductVariantOptionValue {
  variantId     String
  optionValueId String
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@id([variantId, optionValueId])
  @@index([optionValueId, variantId])
}

model ProductVariantMarketPrice {
  id             String         @id @default(cuid())
  variantId      String
  market         Market
  price          Decimal        @db.Decimal(12, 2)
  compareAtPrice Decimal?       @db.Decimal(12, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, market])
  @@index([market, price])
}

model ProductVariantImage {
  variantId      String
  productImageId String
  sortOrder      Int            @default(0)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productImage   ProductImage   @relation(fields: [productImageId], references: [id], onDelete: Cascade)

  @@id([variantId, productImageId])
  @@index([productImageId, variantId])
}

// Localized display and SEO content for a product; SKU and commercial values remain shared.
model ProductTranslation {
  id               String        @id @default(cuid())
  productId        String
  locale           ContentLocale
  name             String
  shortDescription String?
  description      String?
  seoTitle         String?
  metaDescription  String?
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

// Localized display and SEO content for a category; hierarchy and slug remain shared.
model CategoryTranslation {
  id              String        @id @default(cuid())
  categoryId      String
  locale          ContentLocale
  name            String
  description     String?
  seoTitle        String?
  metaDescription String?
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

// Product image ordering and primary-image state; file metadata lives in Media.
// The nullable URL remains only as a legacy fallback for pre-Media records.
model ProductImage {
  id        String                @id @default(cuid())
  productId String
  url       String?
  mediaId   String?
  altText   String?
  sortOrder Int                   @default(0)
  isPrimary Boolean               @default(false)
  createdAt DateTime              @default(now())
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media?                @relation("ProductImageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  variants  ProductVariantImage[]

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@index([mediaId])
}

// ======================================================
// REVIEWS MODULE
// Verified customer purchase reviews and moderation
// ======================================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// A review is anchored to the exact paid, delivered order item that qualified it.
// The composite key prevents one customer from reviewing the same product twice.
model ProductReview {
  id                              String       @id @default(cuid())
  userId                          String
  productId                       String
  orderItemId                     String
  rating                          Int
  comment                         String?
  status                          ReviewStatus @default(PENDING)
  customerVisibleModerationReason String?
  moderatedByUserId               String?
  moderatedAt                     DateTime?
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt
  user                            User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  product                         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem                       OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  moderatedBy                     User?        @relation("ReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ======================================================
// CUSTOMER FAVORITES MODULE
// One private favorites collection per customer
// ======================================================

// Stores a customer's saved product preference.
// The composite key prevents duplicate favorites and both relations cascade safely.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ======================================================
// CUSTOMER MODULE
// Customer profile and saved addresses
// ======================================================

// Stores a customer's reusable delivery address.
// Ownership is enforced through the User relation and customer services.
model CustomerAddress {
  id                String              @id @default(cuid())
  userId            String
  market            Market              @default(EGYPT)
  countryCode       String              @default("EG")
  label             String
  recipientName     String
  phone             String
  country           String
  governorate       String?
  region            String?
  city              String
  district          String?
  area              String?
  street            String
  building          String?
  buildingNumber    String?
  additionalNumber  String?
  shortAddress      String?
  unitNumber        String?
  floor             String?
  apartment         String?
  postalCode        String?
  latitude          Decimal?            @db.Decimal(10, 7)
  longitude         Decimal?            @db.Decimal(10, 7)
  notes             String?
  source            AddressSource       @default(MANUAL)
  verification      AddressVerification @default(UNVERIFIED)
  provider          String?
  providerReference String?
  consentAt         DateTime?
  verifiedAt        DateTime?
  isDefault         Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, market, isDefault])
  @@index([market, verification])
  @@index([providerReference])
}

// Short-lived Saudi National Address resolution state. This is deliberately separate
// from customer-auth OTP challenges and never stores a provider OTP in plaintext.
model AddressResolutionSession {
  id                       String                  @id @default(cuid())
  customerId               String
  market                   Market
  provider                 String
  recipientPhone           String
  providerSessionReference String?
  challengeHash            String?
  choices                  Json?
  attemptCount             Int                     @default(0)
  status                   AddressResolutionStatus @default(PENDING)
  consentAt                DateTime?
  expiresAt                DateTime
  verifiedAt               DateTime?
  completedAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  customer                 User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, market, status, createdAt])
  @@index([providerSessionReference])
  @@index([expiresAt])
}

// ======================================================
// INVENTORY MODULE
// Stock and warehouse management
// ======================================================

// ======================================================
// CART MODULE
// Customer shopping cart
// ======================================================

// One active cart belongs either to one CUSTOMER or to one anonymous guest token.
model Cart {
  id             String     @id @default(cuid())
  customerId     String?    @unique
  guestTokenHash String?    @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  customer       User?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  coupon         Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          CartItem[]
  couponId       String?
  market         Market?

  @@index([updatedAt])
  @@index([couponId])
}

// Stores the checkout snapshot needed for a cart item until Catalog is implemented.
model CartItem {
  id             String          @id @default(cuid())
  cartId         String
  productId      String
  variantId      String?
  variantSku     String?
  variantOptions Json?
  name           String
  imageUrl       String?
  unitPrice      Decimal         @db.Decimal(12, 2)
  quantity       Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  cart           Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
}

// ======================================================
// ORDER MODULE
// Checkout and customer order history
// ======================================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  NOT_ASSIGNED
  READY_FOR_SHIPPING
  WITH_CARRIER
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNING
  RETURNED_TO_STORE
}

enum DeliveryFailureReason {
  CUSTOMER_DID_NOT_ANSWER
  CUSTOMER_REFUSED
  WRONG_ADDRESS
  CUSTOMER_UNAVAILABLE
  OTHER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PENDING_VERIFICATION
  PAID
  PARTIALLY_REFUNDED
  FAILED
  REFUNDED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
  RETURNING
  RECEIVED
  COMPLETED
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  NO_LONGER_NEEDED
  OTHER
}

enum RefundStatus {
  PENDING
  COMPLETED
}

enum RefundMethod {
  BANK_TRANSFER
  WALLET
  ORIGINAL_PAYMENT_METHOD
  CASH
  OTHER
}

enum SettlementStatus {
  PENDING_SETTLEMENT
  SETTLED
}

// Historical order header with authoritative totals and address/payment snapshots.
model Order {
  id                    String                  @id @default(cuid())
  orderNumber           String                  @unique
  checkoutToken         String?                 @unique
  customerId            String
  status                OrderStatus             @default(PENDING)
  paymentStatus         PaymentStatus           @default(UNPAID)
  paymentMethodId       String?
  paymentMethodCode     String
  paymentMethodName     String
  paymentProviderCode   String?
  paymentSnapshot       Json?
  paymentReference      String?
  paymentNotes          String?
  currency              String
  market                Market?
  subtotal              Decimal                 @db.Decimal(12, 2)
  promotionDiscount     Decimal                 @default(0) @db.Decimal(12, 2)
  couponDiscount        Decimal                 @default(0) @db.Decimal(12, 2)
  shippingAmount        Decimal                 @db.Decimal(12, 2)
  shippingCarrierId     String?
  shippingCarrierCode   String?
  shippingCarrierNameAr String?
  shippingCarrierNameEn String?
  shippingRateSource    ShippingRateSource?
  total                 Decimal                 @db.Decimal(12, 2)
  shippingAddress       Json
  paidAt                DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  customer              User                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  paymentMethod         PaymentMethod?          @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentAttempts       PaymentAttempt[]
  bankTransfer          BankTransferSubmission?
  items                 OrderItem[]
  statusHistory         OrderStatusHistory[]
  paymentStatusHistory  PaymentStatusHistory[]
  settlement            PaymentSettlement?
  shipment              OrderShipment?
  settlementItem        CarrierSettlementItem?
  promotions            OrderPromotion[]
  couponSnapshot        OrderCoupon?
  couponRedemption      CouponRedemption?
  returnRequests        ReturnRequest[]

  @@index([customerId, createdAt])
  @@index([status])
  @@index([paymentStatus])
}

// Immutable audit trail for every fulfillment status change.
// The initial order creation is recorded with a null oldStatus.
model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  oldStatus       OrderStatus?
  newStatus       OrderStatus
  changedByUserId String
  note            String?
  createdAt       DateTime     @default(now())
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User         @relation("OrderStatusHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}

// Immutable audit trail for payment status changes and manual verification decisions.
model PaymentStatusHistory {
  id              String         @id @default(cuid())
  orderId         String
  oldStatus       PaymentStatus?
  newStatus       PaymentStatus
  changedByUserId String
  note            String?
  createdAt       DateTime       @default(now())
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy       User           @relation("PaymentStatusHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([changedByUserId])
}

// Tracks COD money after the customer order is delivered and payment is collected.
model PaymentSettlement {
  id              String           @id @default(cuid())
  orderId         String           @unique
  amount          Decimal          @db.Decimal(12, 2)
  status          SettlementStatus @default(PENDING_SETTLEMENT)
  settledByUserId String?
  settledAt       DateTime?
  note            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  settledBy       User?            @relation("PaymentSettlementActor", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([settledByUserId])
}

// Stores immutable item snapshots so future catalog changes do not rewrite history.
model OrderItem {
  id                         String          @id @default(cuid())
  orderId                    String
  productId                  String
  variantId                  String?
  variantSku                 String?
  variantOptions             Json?
  name                       String
  imageUrl                   String?
  unitPrice                  Decimal         @db.Decimal(12, 2)
  quantity                   Int
  isPromotionGift            Boolean         @default(false)
  promotionId                String?
  inventoryTrackedAtPurchase Boolean         @default(false)
  order                      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems                ReturnItem[]
  reviews                    ProductReview[]
  variant                    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([promotionId])
}

// ======================================================
// RETURNS & REFUNDS MODULE
// Post-delivery customer returns and manual refunds
// ======================================================

// A customer request to return one or more items from a delivered order.
model ReturnRequest {
  id              String                @id @default(cuid())
  returnNumber    String                @unique
  orderId         String
  customerId      String
  status          ReturnStatus          @default(REQUESTED)
  reason          ReturnReason
  customerNote    String?
  adminNote       String?
  requestedAt     DateTime              @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  returningAt     DateTime?
  receivedAt      DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer        User                  @relation("ReturnCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("ReturnCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items           ReturnItem[]
  history         ReturnStatusHistory[]
  refund          Refund?

  @@index([customerId, createdAt])
  @@index([status, requestedAt])
  @@index([orderId])
}

// Item-level quantities preserve requested, approved, received, and restocked units separately.
model ReturnItem {
  id                     String        @id @default(cuid())
  returnRequestId        String
  orderItemId            String
  requestedQuantity      Int
  approvedQuantity       Int?
  receivedQuantity       Int           @default(0)
  restockQuantity        Int           @default(0)
  calculatedRefundAmount Decimal       @db.Decimal(12, 2)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  returnRequest          ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem              OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

// Customer-visible lifecycle history for a return request.
model ReturnStatusHistory {
  id                  String        @id @default(cuid())
  returnRequestId     String
  oldStatus           ReturnStatus?
  newStatus           ReturnStatus
  changedByUserId     String
  customerVisibleNote String?
  createdAt           DateTime      @default(now())
  returnRequest       ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  changedBy           User          @relation("ReturnStatusActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([returnRequestId, createdAt])
}

// A manual refund record created after physical receipt of returned merchandise.
model Refund {
  id                String        @id @default(cuid())
  returnRequestId   String        @unique
  status            RefundStatus  @default(PENDING)
  method            RefundMethod?
  amount            Decimal       @db.Decimal(12, 2)
  reference         String?
  note              String?
  processedByUserId String?
  processedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  returnRequest     ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  processedBy       User?         @relation("RefundProcessor", fields: [processedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// ======================================================
// PAYMENT MODULE
// Payment providers and transactions
// ======================================================

enum PaymentMethodType {
  CASH_ON_DELIVERY
  ONLINE_PAYMENT
  BANK_TRANSFER
  // Legacy values retained for data-preserving upgrades. New configuration uses the stable values above.
  MANUAL_TRANSFER
  ONLINE_GATEWAY
}

// Store-configured payment methods offered to customers at checkout.
model PaymentMethod {
  id                   String                      @id @default(cuid())
  code                 String                      @unique
  name                 String
  type                 PaymentMethodType
  enabled              Boolean                     @default(false)
  isSystem             Boolean                     @default(false)
  destination          String?
  instructions         String?
  confirmationWhatsApp String?
  providerKey          String?
  sortOrder            Int                         @default(0)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  orders               Order[]
  marketConfigs        PaymentMethodMarketConfig[]

  @@index([enabled, sortOrder])
}

// Market-scoped availability. The global PaymentMethod row remains the historical identity/snapshot source.
model PaymentMethodMarketConfig {
  id              String        @id @default(cuid())
  paymentMethodId String
  market          Market
  enabled         Boolean       @default(false)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)

  @@unique([market, paymentMethodId])
  @@index([market, enabled, sortOrder])
}

// Customer-facing bank receiving instructions. Secrets never belong here.
model BankTransferAccount {
  id                String   @id @default(cuid())
  market            Market
  bankNameAr        String
  bankNameEn        String
  accountHolderName String
  iban              String
  accountNumber     String?
  swiftCode         String?
  instructionsAr    String?
  instructionsEn    String?
  enabled           Boolean  @default(false)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([market, enabled, isDefault])
}

// One immutable server-side payment attempt per initiation/idempotency key.
model PaymentAttempt {
  id                String        @id @default(cuid())
  orderId           String
  provider          String
  market            Market
  currency          String
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String        @unique
  providerReference String?       @unique
  checkoutUrl       String?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([provider, providerReference])
}

// Bank transfer proof remains reviewable and never auto-promotes an order to PAID.
model BankTransferSubmission {
  id                String        @id @default(cuid())
  orderId           String        @unique
  senderName        String
  transferReference String?
  transferredAmount Decimal?      @db.Decimal(12, 2)
  transferDate      DateTime?
  receiptKey        String?
  receiptMimeType   String?
  receiptSize       Int?
  customerNote      String?
  status            PaymentStatus @default(PENDING_VERIFICATION)
  submittedAt       DateTime      @default(now())
  reviewedAt        DateTime?
  reviewedByUserId  String?
  rejectionReason   String?
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy        User?         @relation("BankTransferReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([reviewedByUserId])
}

// ======================================================
// SHIPPING MODULE
// Shipping companies, deliveries, returns, and COD reconciliation
// ======================================================

// Admin-managed outbound shipping company record.
// A company is deactivated instead of deleted after it has shipment history.
model ShippingCompany {
  id                String                        @id @default(cuid())
  code              String                        @unique @default(cuid())
  name              String
  nameAr            String?
  nameEn            String?
  phone             String?
  contactPerson     String?
  notes             String?
  isActive          Boolean                       @default(true)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  shipments         OrderShipment[]
  settlementBatches CarrierSettlementBatch[]
  marketConfigs     ShippingCarrierMarketConfig[]

  @@index([isActive, name])
}

// Market-specific checkout quote configuration. Additional carriers can be stored
// without exposing customer choice; only one enabled checkout carrier may exist per market.
model ShippingCarrierMarketConfig {
  id                String          @id @default(cuid())
  shippingCompanyId String
  market            Market
  enabled           Boolean         @default(true)
  isCheckoutCarrier Boolean         @default(false)
  rate              Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  shippingCompany   ShippingCompany @relation(fields: [shippingCompanyId], references: [id], onDelete: Cascade)

  @@unique([shippingCompanyId, market])
  @@index([market, enabled, isCheckoutCarrier])
}

// One operational shipment for an order in this single-store template.
// The shipment owns the physical delivery state; Order remains the commercial state.
model OrderShipment {
  id                  String                  @id @default(cuid())
  orderId             String                  @unique
  shippingCompanyId   String?
  trackingNumber      String?
  status              ShipmentStatus          @default(NOT_ASSIGNED)
  handedToCarrierAt   DateTime?
  outForDeliveryAt    DateTime?
  deliveredAt         DateTime?
  failedAt            DateTime?
  failureReason       DeliveryFailureReason?
  failureNote         String?
  returnStartedAt     DateTime?
  returnedToStoreAt   DateTime?
  inventoryRestoredAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingCompany     ShippingCompany?        @relation(fields: [shippingCompanyId], references: [id], onDelete: Restrict)
  statusHistory       ShipmentStatusHistory[]

  @@index([shippingCompanyId, status, updatedAt])
  @@index([status, updatedAt])
  @@index([trackingNumber])
}

// Immutable audit trail for physical shipment transitions.
model ShipmentStatusHistory {
  id              String          @id @default(cuid())
  shipmentId      String
  oldStatus       ShipmentStatus?
  newStatus       ShipmentStatus
  changedByUserId String
  note            String?
  createdAt       DateTime        @default(now())
  shipment        OrderShipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  changedBy       User            @relation("ShipmentStatusHistoryActor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
  @@index([changedByUserId])
}

// A carrier handover of multiple already-delivered COD orders.
// PaymentSettlement remains the per-order financial truth.
model CarrierSettlementBatch {
  id                String                  @id @default(cuid())
  shippingCompanyId String
  reference         String?
  expectedAmount    Decimal                 @db.Decimal(12, 2)
  receivedAmount    Decimal                 @db.Decimal(12, 2)
  receivedAt        DateTime
  note              String?
  createdByUserId   String
  createdAt         DateTime                @default(now())
  shippingCompany   ShippingCompany         @relation(fields: [shippingCompanyId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("CarrierSettlementBatchActor", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items             CarrierSettlementItem[]

  @@index([shippingCompanyId, receivedAt])
}

// One COD order included in exactly one carrier settlement batch.
model CarrierSettlementItem {
  id             String                 @id @default(cuid())
  batchId        String
  orderId        String                 @unique
  expectedAmount Decimal                @db.Decimal(12, 2)
  batch          CarrierSettlementBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([batchId, orderId])
  @@index([batchId])
}

// ======================================================
// PROMOTIONS MODULE
// Commercial offers, spend discounts, Buy X Get Y, and Hero campaigns
// ======================================================

enum PromotionType {
  ORDER_PERCENTAGE_DISCOUNT
  ORDER_FIXED_DISCOUNT
  BUY_X_GET_Y_FREE
}

// Commercial promotional offer with schedules, storefront placements, and specific rules.
model Promotion {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String
  description      String?
  type             PromotionType
  isActive         Boolean       @default(true)
  showInHero       Boolean       @default(false)
  showOnOffersPage Boolean       @default(true)
  bannerMediaId    String?
  priority         Int           @default(0)
  startsAt         DateTime      @default(now())
  endsAt           DateTime?

  // Rule-specific values
  minimumOrderSubtotal Decimal? @db.Decimal(12, 2)
  percentageDiscount   Decimal? @db.Decimal(5, 2)
  fixedDiscountAmount  Decimal? @db.Decimal(12, 2)
  qualifyingProductId  String?
  buyQuantity          Int?
  giftProductId        String?
  giftQuantity         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bannerMedia       Media?                 @relation("PromotionBannerMedia", fields: [bannerMediaId], references: [id], onDelete: SetNull)
  qualifyingProduct Product?               @relation("PromotionQualifyingProduct", fields: [qualifyingProductId], references: [id], onDelete: SetNull)
  giftProduct       Product?               @relation("PromotionGiftProduct", fields: [giftProductId], references: [id], onDelete: SetNull)
  orderPromotions   OrderPromotion[]
  translations      PromotionTranslation[]
  marketRules       PromotionMarketRule[]

  @@index([isActive, startsAt, endsAt, priority])
  @@index([showInHero, isActive])
  @@index([showOnOffersPage, isActive])
  @@index([qualifyingProductId])
  @@index([giftProductId])
  @@index([bannerMediaId])
}

// Monetary promotion thresholds and fixed amounts are scoped to one market.
// Percentage values remain on Promotion because they are currency-independent.
model PromotionMarketRule {
  id                   String    @id @default(cuid())
  promotionId          String
  market               Market
  minimumOrderSubtotal Decimal?  @db.Decimal(12, 2)
  fixedDiscountAmount  Decimal?  @db.Decimal(12, 2)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  promotion            Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, market])
  @@index([market])
}

// Localized customer-facing copy for promotions; discount rules remain shared.
model PromotionTranslation {
  id               String        @id @default(cuid())
  promotionId      String
  locale           ContentLocale
  name             String
  shortDescription String?
  description      String?
  seoTitle         String?
  metaDescription  String?
  promotion        Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, locale])
  @@index([locale])
}

// Immutable historical snapshot of a promotion applied to an order.
model OrderPromotion {
  id             String        @id @default(cuid())
  orderId        String
  promotionId    String?
  promotionName  String
  promotionType  PromotionType
  discountAmount Decimal       @db.Decimal(12, 2)
  ruleSnapshot   Json
  createdAt      DateTime      @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([promotionId])
}

// ======================================================
// COUPON MODULE
// Explicit customer-entered coupon codes and immutable usage history
// ======================================================

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponRedemptionStatus {
  REDEEMED
  REVERSED
}

// A customer-entered code that applies to the whole eligible merchandise subtotal.
model Coupon {
  id                       String             @id @default(cuid())
  name                     String
  code                     String             @unique
  type                     CouponType
  percentageDiscount       Decimal?           @db.Decimal(5, 2)
  fixedDiscountAmount      Decimal?           @db.Decimal(12, 2)
  minimumOrderSubtotal     Decimal            @default(0) @db.Decimal(12, 2)
  maximumDiscountAmount    Decimal?           @db.Decimal(12, 2)
  isActive                 Boolean            @default(true)
  startsAt                 DateTime           @default(now())
  endsAt                   DateTime?
  totalUsageLimit          Int?
  perCustomerUsageLimit    Int?
  canCombineWithPromotions Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  carts                    Cart[]
  redemptions              CouponRedemption[]
  orderSnapshots           OrderCoupon[]
  marketRules              CouponMarketRule[]

  @@index([isActive, startsAt, endsAt])
  @@index([type])
}

// A coupon's monetary terms are never shared across currencies.
model CouponMarketRule {
  id                    String   @id @default(cuid())
  couponId              String
  market                Market
  fixedDiscountAmount   Decimal? @db.Decimal(12, 2)
  minimumOrderSubtotal  Decimal  @default(0) @db.Decimal(12, 2)
  maximumDiscountAmount Decimal? @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  coupon                Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([couponId, market])
  @@index([market])
}

// A successful order-level usage record. Cart applications never create this row.
model CouponRedemption {
  id             String                 @id @default(cuid())
  couponId       String
  customerId     String
  orderId        String                 @unique
  discountAmount Decimal                @db.Decimal(12, 2)
  status         CouponRedemptionStatus @default(REDEEMED)
  redeemedAt     DateTime               @default(now())
  reversedAt     DateTime?
  coupon         Coupon                 @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer       User                   @relation("CouponRedemptionCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId, status, redeemedAt])
  @@index([customerId, couponId, status])
}

// Immutable coupon configuration snapshot kept with the historical order.
model OrderCoupon {
  id                      String     @id @default(cuid())
  orderId                 String     @unique
  couponId                String?
  couponCode              String
  couponName              String
  couponType              CouponType
  configuredValue         Decimal    @db.Decimal(12, 2)
  actualDiscountAmount    Decimal    @db.Decimal(12, 2)
  minimumSubtotalSnapshot Decimal    @db.Decimal(12, 2)
  combinationSnapshot     Json
  createdAt               DateTime   @default(now())
  order                   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon                  Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([couponCode])
}

// ======================================================
// ADMIN AUDIT MODULE
// Append-only business activity performed by administrators
// ======================================================

// Immutable, human-readable record of a successful administrative mutation.
// Generic entity references keep history intact when the source entity is removed.
model AuditLog {
  id                 String   @id @default(cuid())
  actorUserId        String?
  actorNameSnapshot  String
  actorEmailSnapshot String?
  action             String
  entityType         String
  entityId           String?
  entityLabel        String
  changes            Json?
  metadata           Json?
  requestId          String?
  createdAt          DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
}
